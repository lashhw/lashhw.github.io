{% assign selected_projects = site.data.projects | where_exp: 'project', 'project.selected' | sort: 'selected' %}

{% include project_description_assets.liquid %}

<div class="publications">
  <ol class="bibliography">
    {% for project in selected_projects %}
      {% include project_entry.liquid project=project %}
    {% endfor %}
  </ol>
  <p class="small text-muted">More on the <a href="{{ '/projects/' | relative_url }}">full project list</a>.</p>
</div>
