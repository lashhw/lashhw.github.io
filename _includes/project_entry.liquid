<li>
  <div class="row">
    <div class="col-sm-2 mb-2 d-none d-sm-block project-thumb">
      {% if include.project.image %}
        {%
          include figure.liquid
          loading="eager"
          path=include.project.image
          sizes="200px"
          class="preview z-depth-1 rounded"
          zoomable=true
          alt=include.project.title
        %}
      {% endif %}
    </div>
    <div class="col-sm-10">
      <div class="title">{{ include.project.title }}</div>
      <div class="author text-justify project-description">
        <div class="project-description-text">{{ include.project.description }}</div>
        <button type="button" class="project-description-toggle" hidden>… more</button>
      </div>
      <div class="periodical">
        {% if include.project.venue -%}
          <em>{{ include.project.venue }}</em>,
        {%- endif %}
        {{ include.project.year }}
      </div>
      {% if include.project.note %}
        <div class="periodical text-muted">
          <small>{{ include.project.note }}</small>
        </div>
      {% endif %}
      <div class="links">
        {% assign paper = site.data.bib[include.project.bibkey] %}
        {% if paper.doi %}
          <a href="https://doi.org/{{ paper.doi }}" class="btn btn-sm z-depth-0" role="button">Paper</a>
        {% endif %}
        {% if paper.code %}
          <a href="{{ paper.code }}" class="btn btn-sm z-depth-0" role="button">Code</a>
        {% endif %}
        {% for link in include.project.links %}
          <a href="{{ link[1] }}" class="btn btn-sm z-depth-0" role="button">{{ link[0] }}</a>
        {% endfor %}
      </div>
    </div>
  </div>
</li>
